# Paths are resolved relative to this project, regardless of Claude Code working directory.
IMAGE_TEST_MODE=true
IMAGE_ALLOW_BROWSER_GENERATION=false
IMAGE_OUTPUT_DIR=./output
# Additional explicitly authorized roots, separated by semicolon. Must already exist.
IMAGE_ALLOWED_DIRS=
# The folder the MCP client starts this server in (your project) is the workspace: relative paths
# resolve there and it is writable. Home, drive roots and system folders are never used.
# Set IMAGE_USE_WORKSPACE=false to always use IMAGE_OUTPUT_DIR, or IMAGE_WORKSPACE to force a folder.
IMAGE_USE_WORKSPACE=true
IMAGE_WORKSPACE=
IMAGE_BROWSER_PROFILE=./.browser-profile
# Optional installed browser: msedge or chrome. Empty uses Playwright Chromium.
IMAGE_BROWSER_CHANNEL=chrome
IMAGE_TIMEOUT_MS=300000
# Selectors can be adjusted when ChatGPT changes its page.
IMAGE_PROMPT_SELECTOR=#prompt-textarea
IMAGE_SEND_SELECTOR=button[data-testid="send-button"]
IMAGE_RESULT_SELECTOR=[data-message-author-role="assistant"] img
IMAGE_DOWNLOAD_SELECTOR=button[aria-label*="Download"],button[aria-label*="下载"]

# extension uses existing default Chrome; playwright uses separate profile.
IMAGE_BROWSER_MODE=extension
